# App
APP_ENV=development
APP_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-hex-password
POSTGRES_DB=erp
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable&connect_timeout=5

# Redis
REDIS_ADDR=localhost:${REDIS_PORT}
REDIS_PASSWORD=replace-with-a-random-hex-password
REDIS_PORT=6379

# Token: generate a private key with openssl rand -hex 32
JWT_SECRET_KEY=
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h

# Explicit local demo seed only; existing passwords are never reset by rerunning seed
DEMO_PASSWORD=LocalDemoPassword123!

# First production administrator only, supplied to the bootstrap command
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production runtime database role (separate from the migration owner)
APP_DATABASE_USER=
APP_DATABASE_PASSWORD=
